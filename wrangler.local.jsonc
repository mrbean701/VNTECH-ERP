{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mep-warehouse-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mep-warehouse-local",
      "database_id": "local-mep-warehouse",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mep-warehouse-files-local"
    }
  ]
}

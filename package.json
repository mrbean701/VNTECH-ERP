{
  "name": "vntech-erp",
  "version": "5.3.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "node scripts/build-cross-platform.mjs",
    "start": "vinext start",
    "test": "npm run lint && npm run typecheck && npm run test:regression && npm run test:workflow",
    "validate:artifact": "node scripts/validate-artifact.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "db:generate": "drizzle-kit generate",
    "local:setup": "bash scripts/local-setup.sh",
    "local:start": "bash scripts/local-start.sh",
    "local:backup": "bash scripts/local-backup.sh",
    "test:workflow": "node --import tsx tests/workflow-direct.test.ts",
    "test:regression": "node --import tsx --test tests/mobile-menu-interaction.test.mjs tests/project-navigation-consolidation.test.mjs tests/runtime-admin-boq-regression.test.mjs tests/w2-admin-import-role-org.test.mjs tests/trust-lock-foundation.test.mjs tests/security-regression.test.mjs tests/pr01-project-tabs.test.mjs tests/boq-native-import.test.ts tests/boq-dynamic-template.test.ts",
    "test:local-runtime": "node scripts/local-self-test.mjs",
    "test:email": "node tests/email-dispatcher.test.mjs",
    "verify:fingerprint": "node scripts/verify-vntech-fingerprint.mjs",
    "server:start": "node scripts/universal-server.mjs",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "server:health": "node scripts/server-self-test.mjs",
    "migrate:legacy-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs",
    "validate:built-artifact": "node scripts/validate-built-artifact.mjs",
    "verify:migrations": "node scripts/migrate-postgres.mjs --preflight",
    "verify:release": "node scripts/verify-full-release.mjs",
    "test:release-static": "node scripts/release-static-gate.mjs",
    "verify:master-baseline": "node scripts/master-baseline-gate.mjs",
    "verify:css-baseline": "node scripts/css-baseline-audit.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.7.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.22.1",
    "wrangler": "4.92.0",
    "pg": "8.13.3",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "VNTECH ERP – Quản trị & Điều hành"
}
